# Copy to .env.local and fill in your values (do not commit .env.local).
# Create a token at: https://sentry.io/settings/account/api/auth-tokens/
# Scopes needed: org:read, project:read, project:releases (or project:write)
SENTRY_AUTH_TOKEN=sntryu_...
SENTRY_URL=https://sentry.io
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
